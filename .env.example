# dPanda.ng Environment Variables Configuration
# Copy this file to .env.local for local development or set these variables in Vercel.

# Public site URL (for canonical tags, sitemaps, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://www.dpanda.ng

# Supabase (Optional in development - fallback store is active if omitted)
# Get these from your Supabase project dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin Control Center Configuration
# ADMIN_SLUG: Random secret string (≥ 24 chars) defining the hidden route: https://www.dpanda.ng/{ADMIN_SLUG}
# Generate using: node scripts/gen-secret.js
ADMIN_SLUG=dpanda-control-center-2026-secure

# ADMIN_PASSWORD_HASH: Bcrypt hash generated via: node scripts/hash-password.js <your_password>
# Default dev password (if left empty): dpanda-admin-2026
ADMIN_PASSWORD_HASH=

# ADMIN_JWT_SECRET: Secure 32+ byte string used to sign admin session tokens
# Generate using: node scripts/gen-secret.js
ADMIN_JWT_SECRET=dpanda_super_secret_jwt_key_min_32_bytes_long_12345

# Optional Admin Two-Factor Authentication (TOTP)
ADMIN_TOTP_SECRET=

# Rate Limiting via Upstash Redis (Optional - in-memory rate limiting is used as fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# External Rates & Feeds (Optional - CoinGecko public API rate limits apply if omitted)
COINGECKO_API_KEY=
